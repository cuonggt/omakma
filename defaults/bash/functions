# Reusable shell helpers for Omakma installers.
#
# This file is sourced from install.sh and from bin/omakma so that every
# installer (whether run during the initial bootstrap or later via the
# `omakma install` menu) can use the same helpers.

# app_installed <Bundle.app>
# True when the app bundle is already in /Applications. Installers that do
# their own thing -- a tap, a DMG download -- guard on this so every installer
# answers "is it already there?" the same way.
app_installed() {
  [[ -d "/Applications/$1" ]]
}

# app_install <cask> [<Bundle.app>]
# Install a Homebrew cask if its app bundle is not already in /Applications.
# Defaults the bundle name to "<cask>.app"; pass an explicit bundle when the
# cask name and the .app name differ (e.g. cask "google-chrome" -> "Google Chrome.app").
app_install() {
  local cask="$1"
  local bundle="${2:-${cask}.app}"

  app_installed "$bundle" ||
    brew install --cask "$cask" ||
    install_unavailable "$cask"
}

# brew_app_install <formula> [<Bundle.app>]
# Same as app_install but uses `brew install` (no --cask) for formulae that
# install GUI app bundles (alacritty, orbstack, localsend, ...).
brew_app_install() {
  local formula="$1"
  local bundle="${2:-${formula}.app}"

  app_installed "$bundle" ||
    brew install "$formula" ||
    install_unavailable "$formula"
}

OMAKMA_CAFFEINATE_PID=""

# keep_awake
# Stop the machine idling while a long install runs. The caffeinate is stopped
# from an EXIT trap as well as by the explicit let_sleep at the end, because
# install/terminal.sh and install/desktop.sh used to kill it only after their
# installer loop: under `set -e` any failure in that loop skipped the kill
# entirely and left the Mac awake indefinitely, with nothing on screen to say
# so. Calling this twice is fine -- the second call stops the first.
keep_awake() {
  let_sleep

  caffeinate -dims &
  OMAKMA_CAFFEINATE_PID=$!

  trap let_sleep EXIT
}

# let_sleep
# Stop the caffeinate keep_awake started, if there is one. Safe to call more
# than once, so the explicit call and the trap cannot fight over it.
let_sleep() {
  [ -n "${OMAKMA_CAFFEINATE_PID:-}" ] || return 0

  kill "$OMAKMA_CAFFEINATE_PID" 2>/dev/null
  OMAKMA_CAFFEINATE_PID=""

  return 0
}

# brew_install <formula>
# Install a Homebrew formula unless it is already installed. For a CLI tool with
# nothing in /Applications -- reach for app_install or brew_app_install when
# there is an app bundle to guard on.
brew_install() {
  brew list "$1" &>/dev/null ||
    brew install "$1" ||
    install_unavailable "$1"
}

# cask_install <cask>
# Same, for a cask that installs no app bundle of its own (claude-code).
cask_install() {
  brew list --cask "$1" &>/dev/null ||
    brew install --cask "$1" ||
    install_unavailable "$1"
}

# A package Homebrew will not hand over -- disabled, renamed or withdrawn
# upstream -- is not Omakma's error to die on. install.sh runs under `set -e`
# and install/desktop.sh sources its installers in a loop, so one unavailable
# cask took every installer after it (alphabetically, alacritty is the first of
# 28), the Dock and font tweaks, the reboot prompt, and the `caffeinate`
# desktop.sh leaves running. Nothing is swallowed: the name is printed here and
# again by report_failed_installs at the end of the run. Only the `brew install`
# itself is tolerated -- every other failure still stops the install.
OMAKMA_FAILED_INSTALLS=()

# install_unavailable <name>
# Record that a package could not be installed, and carry on.
install_unavailable() {
  OMAKMA_FAILED_INSTALLS+=("$1")
  echo "Could not install $1 from Homebrew. Skipping it and carrying on."

  return 0
}

# report_failed_installs
# Name everything that was skipped, late enough in the run that the user still
# has it on screen. Silent when nothing failed.
report_failed_installs() {
  [ "${#OMAKMA_FAILED_INSTALLS[@]}" -gt 0 ] || return 0

  local app

  echo ""
  echo "Homebrew would not install these, so they were skipped:"
  for app in "${OMAKMA_FAILED_INSTALLS[@]}"; do
    echo "  - $app"
  done
  echo "They may have been disabled, renamed or withdrawn upstream. Everything else is installed."

  return 0
}

OMAKMA_FAILED_UNINSTALLS=()

# uninstall_failed <name>
# Record that Homebrew would not remove a package, and carry on so the rest of
# the uninstaller still runs.
uninstall_failed() {
  OMAKMA_FAILED_UNINSTALLS+=("$1")
  echo "Could not remove $1 with Homebrew."

  return 0
}

# report_failed_uninstalls
# Name anything Homebrew would not remove. Silent when nothing failed.
report_failed_uninstalls() {
  [ "${#OMAKMA_FAILED_UNINSTALLS[@]}" -gt 0 ] || return 0

  local app

  echo ""
  echo "Homebrew could not remove these:"
  for app in "${OMAKMA_FAILED_UNINSTALLS[@]}"; do
    echo "  - $app"
  done
  echo "The app may still be running, or Homebrew may no longer know that name."
  echo "Any config the uninstaller cleans up was still removed."

  return 0
}

# untap_if_unused <tap>
# Remove a tap Omakma added, but only while nothing is installed from it.
#
# A tap is shared ground and keeps no record of who added it, so the test is
# whether anything would be orphaned rather than who owns it. That guard is not
# a courtesy: `brew untap` on a tap that still has packages installed offers to
# uninstall them first and prompts while doing it, which is no way for an
# uninstaller to behave. `--force`, which skips straight to uninstalling them,
# is never passed.
#
# shivammathur/php is deliberately never passed here. `omakma install` installs
# PHP versions from it, so it outlives any single app that happens to need it.
untap_if_unused() {
  local tap="$1"

  brew tap 2>/dev/null | grep -Fqx "$tap" || return 0

  local package
  while IFS= read -r package; do
    case "$package" in
    "$tap"/*)
      echo "Kept the $tap tap: $package is still installed from it."
      return 0
      ;;
    esac
  done <<<"$(brew list --full-name 2>/dev/null)"

  brew untap "$tap" || echo "Could not untap $tap."

  return 0
}

# app_uninstall <cask>
# Remove a Homebrew cask, if it is installed. A cask that is not installed is
# nothing to do rather than a failure, which is what keeps these scripts safe to
# re-run. A removal that genuinely fails is recorded, and Homebrew's reason is
# left on screen: both of these helpers used to end in `|| true` with stderr
# discarded, so every uninstall returned 0 and looked like a success however it
# went.
app_uninstall() {
  brew list --cask "$1" &>/dev/null || return 0

  brew uninstall --cask "$1" || uninstall_failed "$1"
}

# brew_app_uninstall <formula>
# Same as app_uninstall but for non-cask formulae.
brew_app_uninstall() {
  brew list "$1" &>/dev/null || return 0

  brew uninstall "$1" || uninstall_failed "$1"
}

# copy_config <src> <dst>
# Copy an Omakma config over a file the user may already own, keeping what was
# there as <dst>.bak. An existing backup is never overwritten: re-running an
# installer would otherwise replace the user's original with Omakma's own copy
# from the previous run. A file that already matches what is about to replace it
# is not backed up either -- there is nothing of the user's to keep, and a .bak
# holding Omakma's own config is worse than none, because an uninstaller cannot
# tell it apart from a real one and will faithfully restore it.
copy_config() {
  local src="$1"
  local dst="$2"

  mkdir -p "$(dirname "$dst")"

  if [[ -f "$dst" && ! -e "$dst.bak" ]] && ! cmp -s "$dst" "$src"; then
    mv "$dst" "$dst.bak"
  fi

  cp "$src" "$dst"
}

# backup_config <file>
# Keep what is in a file Omakma is about to change in place, as <file>.bak, the
# way copy_config does for a file it overwrites wholesale. An existing backup is
# never replaced, so re-running an installer cannot bury the user's original
# under Omakma's own copy from a previous run.
backup_config() {
  local file="$1"

  [ -f "$file" ] || return 0
  [ -e "$file.bak" ] && return 0

  cp "$file" "$file.bak"
}

# remove_installed_config <file> <source>...
# Remove a config file Omakma installed, but only while it still matches one of
# the sources Omakma could have put there -- `omakma theme` recopies some of
# them, so more than one source can be legitimate. A file matching none of them,
# because the user wrote it or has edited it since, is kept and reported: an
# uninstaller that cannot show it owns a file has no business deleting it.
remove_installed_config() {
  local file="$1"
  shift

  [[ -f "$file" ]] || return 0

  local src
  for src in "$@"; do
    if [[ -f "$src" ]] && cmp -s "$file" "$src"; then
      rm -f "$file"
      return 0
    fi
  done

  echo "Kept $file: it differs from the copy Omakma installed."
}

# remove_installed_clone <dir> <url>
# Remove a git clone Omakma made, but only while its origin still points at the
# URL Omakma cloned from. The installers skip a package directory that is
# already there, so one with a different origin -- or none at all -- belongs to
# the user and stays. A clone cannot be matched by content the way a config file
# can, so the remote is the next best evidence of who made it.
remove_installed_clone() {
  local dir="$1"
  local url="$2"

  [ -d "$dir" ] || return 0

  local origin
  origin=$(git -C "$dir" config --get remote.origin.url 2>/dev/null)

  if [ "$origin" = "$url" ]; then
    rm -rf "$dir"
    return 0
  fi

  echo "Kept $dir: it is not the clone Omakma made."
}

# remove_empty_dir <dir>...
# Remove each directory, but only while it is empty, so one Omakma created goes
# away and one still holding the user's own files stays. Innermost first.
remove_empty_dir() {
  local dir

  for dir in "$@"; do
    [[ -d "$dir" ]] && rmdir "$dir" 2>/dev/null
  done

  return 0
}

# restore_config_backup <file>...
# Put back the original that copy_config moved aside, now that Omakma's own copy
# is gone. Only acts when the file is absent, so it can never land on top of
# something the user has edited since -- and an uninstaller only gets the file
# out of the way when it could show the file was Omakma's.
restore_config_backup() {
  local file

  for file in "$@"; do
    if [[ ! -e "$file" && -f "$file.bak" ]]; then
      mv "$file.bak" "$file"
      echo "Restored $file from the backup Omakma made when it installed."
    fi
  done

  return 0
}
