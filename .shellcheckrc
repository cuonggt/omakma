# All scripts are sourced as bash; avoid SC2148 "add a shebang" on every file
shell=bash

# Disable warnings for sourced files that can't be resolved statically
disable=SC1090
disable=SC1091

# Variables are often set in one script and used in another via sourcing
disable=SC2034
disable=SC2154

# Installers, sub-commands and migrations are sourced, so an early `return N`
# ends them; the `|| exit N` half only runs when one is executed directly,
# which is how they get tested. SC2317 reads that exit as unreachable.
disable=SC2317

# Test cases stub `brew`, `app_installed` and the install helpers so the real
# installers can be sourced without touching the machine. The stubs are reached
# only through the sourced script under test, which ShellCheck cannot see, so
# SC2329 reads every one of them as dead.
disable=SC2329
